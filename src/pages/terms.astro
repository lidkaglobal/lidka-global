---
// src/pages/terms.astro
// LIDKA GLOBAL - Official Terms and Conditions (Google Play & Web Compliant)
const companyName = "LIDKA GLOBAL";
const siteUrl = "https://lidkaglobal.com";
const pageUrl = `${siteUrl}/terms`;
const contactEmail = "lidkaglobal@gmail.com";
const pageTitle = "Terms of Service & Conditions — LIDKA GLOBAL";
const pageDescription = "Official Terms of Service and Conditions governing the use of LIDKA GLOBAL mobile applications and web services.";
const currentYear = new Date().getFullYear();
const lastUpdated = "October 2026";

// Schema.org Structured Data
const termsSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": companyName,
        "url": siteUrl
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": siteUrl
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Terms of Service",
            "item": pageUrl
          }
        ]
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO & Indexation -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={companyName} />

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(termsSchema)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
      :root {
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --primary-light: #eff6ff;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --slate-50: #f8fafc;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #ffffff;
        color: var(--slate-900);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 24px;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--slate-200);
      }

      .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      .logo-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--slate-900);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.5px;
      }

      .logo-badge {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.92rem;
        font-weight: 500;
        transition: color 0.2s ease;
      }

      .nav-links a:hover {
        color: var(--primary);
      }

      .page-hero {
        padding: 60px 0 40px;
        border-bottom: 1px solid var(--slate-200);
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
      }

      .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 9999px;
        background-color: var(--primary-light);
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 16px;
      }

      .page-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -1px;
        color: var(--slate-900);
        margin-bottom: 8px;
      }

      .last-updated {
        font-size: 0.88rem;
        color: var(--slate-500);
      }

      .terms-content {
        padding: 50px 0 90px;
      }

      .terms-section {
        margin-bottom: 40px;
      }

      .terms-section h2 {
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--slate-900);
        margin-bottom: 14px;
        letter-spacing: -0.4px;
      }

      .terms-section p {
        font-size: 0.96rem;
        color: var(--slate-700);
        margin-bottom: 14px;
      }

      .terms-section ul {
        margin-left: 24px;
        margin-bottom: 16px;
      }

      .terms-section li {
        font-size: 0.95rem;
        color: var(--slate-700);
        margin-bottom: 8px;
      }

      .highlight-box {
        background: var(--slate-50);
        border: 1px solid var(--slate-200);
        border-left: 4px solid var(--primary);
        border-radius: 8px;
        padding: 18px 20px;
        margin: 20px 0;
        font-size: 0.92rem;
        color: var(--slate-700);
      }

      footer {
        background: var(--slate-50);
        border-top: 1px solid var(--slate-200);
        padding: 64px 0 32px;
      }

      .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 40px;
        margin-bottom: 48px;
      }

      .footer-col h5 {
        font-size: 0.82rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .footer-col ul {
        list-style: none;
      }

      .footer-col ul li {
        margin-bottom: 10px;
      }

      .footer-col ul li a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.88rem;
        transition: color 0.2s ease;
      }

      .footer-col ul li a:hover {
        color: var(--primary);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--slate-200);
        font-size: 0.82rem;
        color: var(--slate-500);
      }

      .mobile-toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      }

      .mobile-menu {
        display: none;
        flex-direction: column;
        gap: 12px;
        padding: 16px 24px;
        background: white;
        border-bottom: 1px solid var(--slate-200);
      }

      .mobile-menu a {
        text-decoration: none;
        color: var(--slate-700);
        font-weight: 600;
        padding: 6px 0;
      }

      @media (max-width: 900px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .nav-links {
          display: none;
        }

        .mobile-toggle {
          display: block;
        }

        .page-title {
          font-size: 2rem;
        }
      }
    </style>
  </head>

  <body>
    <!-- Header -->
    <header>
      <div class="nav-bar">
        <a href="/" class="logo-link">
          <div class="logo-badge">L</div>
          <span>LIDKA GLOBAL</span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/services">Services</a>
          <a href="/portfolio">Portfolio</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>

        <button id="mobileBtn" class="mobile-toggle" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

      <nav id="mobileMenu" class="mobile-menu" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/portfolio">Portfolio</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="page-hero">
        <div class="container">
          <div class="badge-pill">Legal Terms & Usage Agreement</div>
          <h1 class="page-title">Terms of Service</h1>
          <p class="last-updated">Last Updated: {lastUpdated} | Effective Date: {lastUpdated}</p>
        </div>
      </section>

      <!-- Terms Content -->
      <article class="terms-content">
        <div class="container">

          <div class="terms-section">
            <h2>1. Acceptance of Terms</h2>
            <p>
              These Terms of Service ("Terms") govern your access to and use of websites, digital services, and mobile applications created and published by <strong>{companyName}</strong> ("we", "us", or "our"), including <strong>lidkaglobal.com</strong> and applications distributed via the Google Play Store.
            </p>
            <p>
              By installing, downloading, browsing, or using our applications or websites, you agree to be bound by these Terms and our Privacy Policy. If you do not agree to these Terms, please do not download, install, or use our software.
            </p>
          </div>

          <div class="terms-section">
            <h2>2. License to Use</h2>
            <p>
              Subject to these Terms, {companyName} grants you a personal, worldwide, non-exclusive, non-transferable, revocable license to download, install, and run our mobile applications and access our web utilities on compatible personal devices solely for your personal or internal business utility.
            </p>
            <p>You agree that you will not:</p>
            <ul>
              <li>Reverse engineer, decompile, disassemble, or attempt to derive the source code of our Android applications (APK/AAB packages) or web binaries.</li>
              <li>Modify, adapt, translate, rent, lease, sublicense, or create derivative works based on our applications or brand assets.</li>
              <li>Circumvent or attempt to disable any security features, digital rights management, or monetization mechanisms incorporated into our applications.</li>
              <li>Use our software for any unlawful purpose, fraud, or violation of applicable local, national, or international regulations.</li>
            </ul>
          </div>

          <div class="terms-section">
            <h2>3. Intellectual Property Rights</h2>
            <p>
              All software, codebases, user interface designs, visual layouts, graphics, branding, text, and trademarks associated with {companyName} and lidkaglobal.com are the proprietary intellectual property of {companyName} and are protected by applicable intellectual property laws.
            </p>
            <p>
              Nothing in these Terms grants you ownership or proprietary interest in any software, assets, or trademarks owned by {companyName}.
            </p>
          </div>

          <div class="terms-section">
            <h2>4. Third-Party Services & Advertising (Google AdMob)</h2>
            <p>
              Our mobile applications may integrate third-party services and Software Development Kits (SDKs), including <strong>Google AdMob</strong> and Google Play Services, to display advertisements and provide analytics.
            </p>
            <div class="highlight-box">
              <strong>Third-Party Disclaimer:</strong> We do not control or endorse the content, goods, or services featured in third-party advertisements served via Google AdMob. Any interactions, purchases, or engagements made with advertisers are strictly between you and the respective third-party provider.
            </div>
            <p>
              Your use of Google Play Services and interaction with advertisements is also subject to Google’s terms:
            </p>
            <ul>
              <li><a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer" style="color: var(--primary);">Google Terms of Service</a></li>
              <li><a href="https://play.google.com/about/play-terms/" target="_blank" rel="noopener noreferrer" style="color: var(--primary);">Google Play Terms of Service</a></li>
            </ul>
          </div>

          <div class="terms-section">
            <h2>5. Disclaimer of Warranties</h2>
            <p>
              Our applications, web utilities, and information are provided on an <strong>"AS IS"</strong> and <strong>"AS AVAILABLE"</strong> basis, without warranties of any kind, whether express, implied, statutory, or otherwise.
            </p>
            <p>
              To the fullest extent permitted by applicable law, {companyName} expressly disclaims all warranties, including but not limited to implied warranties of merchantability, fitness for a particular purpose, uninterrupted operation, and non-infringement. We do not warrant that our software will be error-free, uninterrupted, or compatible with all hardware and operating system variations.
            </p>
          </div>

          <div class="terms-section">
            <h2>6. Limitation of Liability</h2>
            <p>
              To the maximum extent permitted by applicable law, in no event shall {companyName}, its owners, developers, or affiliates be liable for any indirect, incidental, special, consequential, or punitive damages, including loss of data, profits, device malfunction, or business interruption arising out of or related to your use of or inability to use our applications or websites.
            </p>
          </div>

          <div class="terms-section">
            <h2>7. App Updates & Termination</h2>
            <p>
              We reserve the right to modify, update, patch, suspend, or discontinue any application or service at any time without prior notice. We may release updates through the Google Play Store to fix bugs, optimize performance, or comply with new operating system guidelines.
            </p>
            <p>
              We reserve the right to revoke or terminate your license to use our applications immediately if you violate any provision of these Terms.
            </p>
          </div>

          <div class="terms-section">
            <h2>8. Changes to These Terms</h2>
            <p>
              We may revise these Terms of Service periodically. When revisions occur, we will update the "Last Updated" date at the top of this page. Your continued use of our websites or applications following any changes constitutes your binding acceptance of the updated Terms.
            </p>
          </div>

          <div class="terms-section">
            <h2>9. Contact Information</h2>
            <p>
              For legal inquiries, clarification, or questions regarding these Terms of Service, please contact us:
            </p>
            <div class="highlight-box">
              <strong>{companyName}</strong><br />
              Official Website: <a href={siteUrl} style="color: var(--primary);">{siteUrl}</a><br />
              Legal & Support Email: <a href={`mailto:${contactEmail}`} style="color: var(--primary);">{contactEmail}</a>
            </div>
          </div>

        </div>
      </article>
    </main>

    <!-- Global Footer -->
    <footer>
      <div class="footer-container">
        <div class="footer-grid">
          <div>
            <div class="logo-link" style="margin-bottom: 12px;">
              <div class="logo-badge" style="width: 30px; height: 30px; font-size: 0.9rem;">L</div>
              <span style="font-size: 1.1rem;">LIDKA GLOBAL</span>
            </div>
            <p style="font-size: 0.85rem; color: var(--slate-500); line-height: 1.6; margin-bottom: 8px;">
              Independent software and app engineering firm creating lightweight, scalable tools.
            </p>
            <p style="font-size: 0.8rem; color: var(--slate-700); font-family: 'JetBrains Mono', monospace;">
              lidkaglobal.com
            </p>
          </div>

          <div class="footer-col">
            <h5>Navigation</h5>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/portfolio">Portfolio</a></li>
              <li><a href="/about">About Us</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h5>Legal & Security</h5>
            <ul>
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms" style="color: var(--primary);">Terms of Service</a></li>
              <li><a href="/robots.txt">robots.txt</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h5>Contact</h5>
            <ul>
              <li>
                <a href={`mailto:${contactEmail}`} style="font-weight: 600; color: var(--primary);">
                  {contactEmail}
                </a>
              </li>
              <li style="font-size: 0.8rem; color: var(--slate-500); margin-top: 8px;">
                Direct inquiries answered within 24 business hours.
              </li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <div>&copy; {currentYear} LIDKA GLOBAL. All rights reserved.</div>
          <div>
            <a href="/privacy" style="text-decoration: none; color: var(--slate-500); margin-right: 16px;">Privacy</a>
            <a href="/terms" style="text-decoration: none; color: var(--slate-500);">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Drawer Script -->
    <script is:inline>
      const btn = document.getElementById('mobileBtn');
      const menu = document.getElementById('mobileMenu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
        });
      }
    </script>
  </body>
</html>
