---
// src/pages/contact.astro
// LIDKA GLOBAL - Official Contact & Communications Page
const companyName = "LIDKA GLOBAL";
const siteUrl = "https://lidkaglobal.com";
const pageUrl = `${siteUrl}/contact`;
const contactEmail = "lidkaglobal@gmail.com";
const pageTitle = "Contact LIDKA GLOBAL — Start a Project or Inquire";
const pageDescription = "Get in touch with LIDKA GLOBAL for native Android application development, high-speed Astro web platforms, or technical consultations. Direct response within 24 hours.";
const currentYear = new Date().getFullYear();

// SEO Schema.org (JSON-LD) for Google Search Console
const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": companyName,
        "url": siteUrl
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": siteUrl
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Contact",
            "item": pageUrl
          }
        ]
      }
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": companyName,
      "url": siteUrl,
      "email": contactEmail,
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": contactEmail,
          "contactType": "customer support"
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO & Indexation -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={companyName} />

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
      :root {
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --primary-light: #eff6ff;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --slate-50: #f8fafc;
        --emerald: #10b981;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #ffffff;
        color: var(--slate-900);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Header */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--slate-200);
      }

      .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }

      .logo-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--slate-900);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.5px;
      }

      .logo-badge {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.92rem;
        font-weight: 500;
        transition: color 0.2s ease;
      }

      .nav-links a:hover, .nav-links a.active {
        color: var(--primary);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
      }

      .btn-primary {
        background-color: var(--primary);
        color: white;
      }

      .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-1px);
      }

      .btn-dark {
        background-color: var(--slate-900);
        color: white;
      }

      .btn-dark:hover {
        background-color: var(--slate-800);
      }

      /* Hero */
      .page-hero {
        padding: 70px 0 40px;
        text-align: center;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        border-bottom: 1px solid var(--slate-200);
      }

      .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 9999px;
        background-color: var(--primary-light);
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 16px;
        border: 1px solid rgba(37, 99, 235, 0.15);
      }

      .page-title {
        font-size: 2.8rem;
        font-weight: 800;
        letter-spacing: -1.2px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .page-desc {
        font-size: 1.15rem;
        color: var(--slate-600);
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.6;
      }

      /* Contact Layout */
      .contact-section {
        padding: 70px 0 100px;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: 56px;
        align-items: flex-start;
      }

      .info-box {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .info-card {
        background: white;
        border: 1px solid var(--slate-200);
        border-radius: 16px;
        padding: 28px;
      }

      .info-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }

      .info-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .info-card h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--slate-900);
      }

      .info-card p {
        font-size: 0.92rem;
        color: var(--slate-600);
        line-height: 1.6;
      }

      .email-link {
        display: inline-block;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--primary);
        text-decoration: none;
        margin-top: 10px;
        font-family: 'JetBrains Mono', monospace;
      }

      .email-link:hover {
        text-decoration: underline;
      }

      .sla-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-radius: 12px;
        background: var(--slate-50);
        border: 1px solid var(--slate-200);
        font-size: 0.88rem;
        color: var(--slate-600);
      }

      .sla-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--emerald);
        flex-shrink: 0;
      }

      /* Form */
      .form-card {
        background: white;
        border: 1px solid var(--slate-200);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.04);
      }

      .form-group {
        margin-bottom: 22px;
      }

      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
      }

      label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--slate-700);
        margin-bottom: 8px;
      }

      input[type="text"],
      input[type="email"],
      select,
      textarea {
        width: 100%;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid var(--slate-200);
        background-color: var(--slate-50);
        font-family: inherit;
        font-size: 0.92rem;
        color: var(--slate-900);
        outline: none;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--primary);
        background-color: #ffffff;
      }

      textarea {
        resize: vertical;
        min-height: 130px;
      }

      .submit-btn {
        width: 100%;
        padding: 14px;
        border-radius: 10px;
        background-color: var(--primary);
        color: white;
        font-size: 0.95rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
        transition: all 0.2s ease;
      }

      .submit-btn:hover {
        background-color: var(--primary-hover);
        transform: translateY(-1px);
      }

      .btn-note {
        text-align: center;
        font-size: 0.82rem;
        color: var(--slate-500);
        margin-top: 12px;
      }

      /* Footer */
      footer {
        background: var(--slate-50);
        border-top: 1px solid var(--slate-200);
        padding: 64px 0 32px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 40px;
        margin-bottom: 48px;
      }

      .footer-col h5 {
        font-size: 0.82rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .footer-col ul {
        list-style: none;
      }

      .footer-col ul li {
        margin-bottom: 10px;
      }

      .footer-col ul li a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.88rem;
        transition: color 0.2s ease;
      }

      .footer-col ul li a:hover {
        color: var(--primary);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--slate-200);
        font-size: 0.82rem;
        color: var(--slate-500);
      }

      .mobile-toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      }

      .mobile-menu {
        display: none;
        flex-direction: column;
        gap: 12px;
        padding: 16px 24px;
        background: white;
        border-bottom: 1px solid var(--slate-200);
      }

      .mobile-menu a {
        text-decoration: none;
        color: var(--slate-700);
        font-weight: 600;
        padding: 6px 0;
      }

      @media (max-width: 900px) {
        .contact-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .nav-links, .header-cta {
          display: none;
        }

        .mobile-toggle {
          display: block;
        }

        .page-title {
          font-size: 2.2rem;
        }

        .form-card {
          padding: 24px;
        }

        .form-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <!-- Header -->
    <header>
      <div class="container nav-bar">
        <a href="/" class="logo-link">
          <div class="logo-badge">L</div>
          <span>LIDKA GLOBAL</span>
        </a>

        <!-- Individual Crawlable Links -->
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/services">Services</a>
          <a href="/portfolio">Portfolio</a>
          <a href="/about">About</a>
          <a href="/contact" class="active">Contact</a>
        </nav>

        <div class="header-cta">
          <a href="/start-project" class="btn btn-dark">Start Project &rarr;</a>
        </div>

        <button id="mobileBtn" class="mobile-toggle" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <nav id="mobileMenu" class="mobile-menu" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/portfolio">Portfolio</a>
        <a href="/about">About</a>
        <a href="/contact" style="color: var(--primary);">Contact</a>
        <a href="/start-project" style="color: var(--primary);">Start Project &rarr;</a>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="page-hero">
        <div class="container">
          <div class="badge-pill">Direct Communications</div>
          <h1 class="page-title">Get in Touch</h1>
          <p class="page-desc">
            Have a project concept, technical question, or partnership inquiry? Reach out to LIDKA GLOBAL directly and we’ll review your details.
          </p>
        </div>
      </section>

      <!-- Contact Info & Form -->
      <section class="contact-section">
        <div class="container contact-grid">
          
          <!-- Left Column: Details & SLA -->
          <div class="info-box">
            <div class="info-card">
              <div class="info-card-header">
                <div class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                </div>
                <h3>Official Inquiries</h3>
              </div>
              <p>For project scoping documents, partnership requests, and technical architecture:</p>
              <a href={`mailto:${contactEmail}`} class="email-link">{contactEmail}</a>
            </div>

            <div class="info-card">
              <div class="info-card-header">
                <div class="info-icon" style="background: #f0fdf4; color: #16a34a;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                    <path d="M12 18h.01"/>
                  </svg>
                </div>
                <h3>Engineering Focus</h3>
              </div>
              <p>
                We specialize strictly in native Android mobile software (Kotlin & Jetpack Compose) and clean, sub-second web architectures (Astro & Edge CDN).
              </p>
            </div>

            <div class="sla-box">
              <span class="sla-dot"></span>
              <div>
                <strong>Active Engineering Status:</strong> All inquiries are reviewed and answered within 24 business hours.
              </div>
            </div>
          </div>

          <!-- Right Column: Interactive Form -->
          <div class="form-card">
            <form id="directContactForm">
              <div class="form-row">
                <div class="form-group">
                  <label for="userName">Your Name / Organization</label>
                  <input type="text" id="userName" name="userName" required placeholder="e.g. Saravanan Kannan" />
                </div>
                <div class="form-group">
                  <label for="userEmail">Email Address</label>
                  <input type="email" id="userEmail" name="userEmail" required placeholder="e.g. saravanan@example.com" />
                </div>
              </div>

              <div class="form-group">
                <label for="projectCategory">Project Category</label>
                <select id="projectCategory" name="projectCategory">
                  <option value="Native Android Mobile Application">Native Android Mobile App (Kotlin / Compose)</option>
                  <option value="High-Speed Astro Web Portal">High-Speed Astro Web Portal</option>
                  <option value="Core Web Vitals & Search Indexing Optimization">Core Web Vitals & Crawlability Audit</option>
                  <option value="General Technical Partnership">General Consultation / Inquiry</option>
                </select>
              </div>

              <div class="form-group">
                <label for="userMessage">Message / Project Summary</label>
                <textarea id="userMessage" name="userMessage" required placeholder="Describe your vision, core features, timeline, and questions..."></textarea>
              </div>

              <button type="submit" class="submit-btn">
                Send Inquiry to {contactEmail} &rarr;
              </button>
              <p class="btn-note">
                Clicking opens your default email client with your message pre-formatted.
              </p>
            </form>
          </div>

        </div>
      </section>
    </main>

    <!-- Global Footer -->
    <footer>
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="logo-link" style="margin-bottom: 12px;">
              <div class="logo-badge" style="width: 30px; height: 30px; font-size: 0.9rem;">L</div>
              <span style="font-size: 1.1rem;">LIDKA GLOBAL</span>
            </div>
            <p style="font-size: 0.85rem; color: var(--slate-500); line-height: 1.6; margin-bottom: 8px;">
              Independent software and app engineering firm creating lightweight, scalable tools.
            </p>
            <p style="font-size: 0.8rem; color: var(--slate-700); font-family: 'JetBrains Mono', monospace;">
              lidkaglobal.com
            </p>
          </div>

          <div class="footer-col">
            <h5>Navigation</h5>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/portfolio">Portfolio</a></li>
              <li><a href="/about">About Us</a></li>
              <li><a href="/start-project">Start Project</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h5>SEO & Legal</h5>
            <ul>
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms">Terms of Service</a></li>
              <li><a href="/robots.txt">robots.txt</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h5>Direct Contact</h5>
            <ul>
              <li>
                <a href={`mailto:${contactEmail}`} style="font-weight: 600; color: var(--primary);">
                  {contactEmail}
                </a>
              </li>
              <li style="font-size: 0.8rem; color: var(--slate-500); margin-top: 8px;">
                Responses provided within 24 business hours.
              </li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <div>&copy; {currentYear} LIDKA GLOBAL. All rights reserved.</div>
          <div>
            <a href="/privacy" style="text-decoration: none; color: var(--slate-500); margin-right: 16px;">Privacy</a>
            <a href="/terms" style="text-decoration: none; color: var(--slate-500);">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Form Handler & Mobile Menu Script -->
    <script is:inline>
      // Mobile Drawer Toggle
      const btn = document.getElementById('mobileBtn');
      const menu = document.getElementById('mobileMenu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
        });
      }

      // Contact Form Mailto Action
      const contactForm = document.getElementById('directContactForm');
      if (contactForm) {
        contactForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const name = document.getElementById('userName').value;
          const email = document.getElementById('userEmail').value;
          const category = document.getElementById('projectCategory').value;
          const message = document.getElementById('userMessage').value;

          const subject = encodeURIComponent(`LIDKA GLOBAL Inquiry: ${name} (${category})`);
          const body = encodeURIComponent(
            `Name: ${name}\nEmail: ${email}\nCategory: ${category}\n\nProject Scope / Message:\n${message}\n\nSent via lidkaglobal.com/contact`
          );

          window.location.href = `mailto:lidkaglobal@gmail.com?subject=${subject}&body=${body}`;
        });
      }
    </script>
  </body>
</html>
