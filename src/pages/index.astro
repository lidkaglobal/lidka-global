            <div class="tech-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200">Google Play Console</div>
            <div class="tech-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200">Google Search Console</div>
