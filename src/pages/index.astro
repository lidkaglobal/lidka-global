---
// src/pages/index.astro
// LIDKA GLOBAL - Modern, Clean & High-Performance Homepage
const companyName = "LIDKA GLOBAL";
const siteUrl = "https://lidkaglobal.com";
const contactEmail = "lidkaglobal@gmail.com";
const pageTitle = "LIDKA GLOBAL — Modern Android Apps & Web Engineering";
const pageDescription = "LIDKA GLOBAL designs native Android applications and high-speed web platforms with clean code, modern UI, and sub-second load times.";
const currentYear = new Date().getFullYear();

// SEO Schema.org (JSON-LD) for Google Search Console
const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": companyName,
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.svg`,
      "email": contactEmail,
      "description": pageDescription,
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": contactEmail,
          "contactType": "customer service"
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": companyName,
      "description": pageDescription,
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Metadata -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content={companyName} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={companyName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
    </style>
  </head>

  <body class="bg-white text-slate-900 selection:bg-blue-600 selection:text-white min-h-screen flex flex-col">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-2.5 font-bold text-lg tracking-tight text-slate-900 hover:opacity-90">
          <span class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm shadow-sm">
            L
          </span>
          <span>LIDKA GLOBAL</span>
        </a>

        <!-- Desktop Navigation (Distinct Pages) -->
        <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
          <a href="/" class="text-blue-600 font-semibold">Home</a>
          <a href="/services" class="hover:text-slate-900 transition-colors">Services</a>
          <a href="/portfolio" class="hover:text-slate-900 transition-colors">Portfolio</a>
          <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
          <a href="/contact" class="hover:text-slate-900 transition-colors">Contact</a>
        </nav>

        <!-- CTA Action -->
        <div class="hidden md:flex items-center gap-4">
          <a 
            href="/start-project" 
            class="px-4 py-2 text-sm font-medium text-white bg-slate-900 hover:bg-slate-800 rounded-lg shadow-sm transition-all"
          >
            Start Project
          </a>
        </div>

        <!-- Mobile Drawer Toggle Button -->
        <button id="mobileMenuBtn" aria-label="Toggle Menu" class="md:hidden p-2 text-slate-600 hover:text-slate-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <nav id="mobileMenu" aria-label="Mobile Navigation" class="hidden md:hidden px-6 py-4 bg-white border-b border-slate-200 flex flex-col gap-3 text-sm font-medium text-slate-700">
        <a href="/" class="text-blue-600 font-semibold py-1">Home</a>
        <a href="/services" class="hover:text-slate-900 py-1">Services</a>
        <a href="/portfolio" class="hover:text-slate-900 py-1">Portfolio</a>
        <a href="/about" class="hover:text-slate-900 py-1">About</a>
        <a href="/contact" class="hover:text-slate-900 py-1">Contact</a>
        <a href="/start-project" class="mt-2 text-center py-2.5 rounded-lg bg-slate-900 text-white font-medium">Start Project</a>
      </nav>
    </header>

    <main class="flex-grow">
      <!-- Hero Section -->
      <section class="max-w-6xl mx-auto px-6 pt-16 pb-20 md:pt-24 md:pb-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7 flex flex-col items-start">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-6">
              <span class="w-2 h-2 rounded-full bg-blue-600"></span>
              Modern App & Web Development Firm
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-6">
              We build mobile apps and web platforms that scale.
            </h1>

            <p class="text-lg text-slate-600 leading-relaxed mb-8 max-w-xl">
              LIDKA GLOBAL engineers responsive Android applications and high-performance web systems. Clean code architecture, zero clutter, and engineered for sub-second speeds.
            </p>

            <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
              <a 
                href="/start-project" 
                class="w-full sm:w-auto px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm text-center shadow-sm transition-colors"
              >
                Start a Project
              </a>
              <a 
                href="/services" 
                class="w-full sm:w-auto px-6 py-3 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700 font-medium text-sm text-center transition-colors"
              >
                View Services
              </a>
            </div>

            <!-- Trust / Quick points -->
            <div class="mt-10 pt-8 border-t border-slate-200 grid grid-cols-3 gap-6 text-slate-600 text-xs w-full max-w-md">
              <div>
                <p class="font-bold text-slate-900 text-sm">Native Android</p>
                <p class="text-slate-500">Kotlin & Jetpack</p>
              </div>
              <div>
                <p class="font-bold text-slate-900 text-sm">Fast Web</p>
                <p class="text-slate-500">Astro & Cloudflare</p>
              </div>
              <div>
                <p class="font-bold text-slate-900 text-sm">100% Crawlable</p>
                <p class="text-slate-500">Googlebot optimized</p>
              </div>
            </div>
          </div>

          <!-- Product / Code Card Graphic -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="w-full max-w-md bg-slate-900 rounded-2xl shadow-xl border border-slate-800 p-6 text-slate-300">
              
              <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-5">
                <div class="flex gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                </div>
                <span class="text-xs font-mono text-slate-400">AppModule.kt</span>
              </div>

              <!-- Code Preview -->
              <div class="font-mono text-xs leading-relaxed space-y-2 text-slate-300">
                <p class="text-slate-500">// Native Android Architecture</p>
                <p><span class="text-purple-400">class</span> <span class="text-blue-400">LidkaApplication</span> : Application() &#123;</p>
                <p class="pl-4"><span class="text-purple-400">override fun</span> <span class="text-amber-400">onCreate</span>() &#123;</p>
                <p class="pl-8 text-emerald-400">super.onCreate()</p>
                <p class="pl-8 text-slate-400">// Zero bloat, instant startup</p>
                <p class="pl-8"><span class="text-sky-300">initializeCoreEngine</span>(speed = <span class="text-rose-400">1.0</span>)</p>
                <p class="pl-4">&#125;</p>
                <p>&#125;</p>
              </div>

              <!-- Performance indicator box -->
              <div class="mt-6 pt-4 border-t border-slate-800 grid grid-cols-2 gap-3 text-xs">
                <div class="bg-slate-800/60 p-3 rounded-lg">
                  <p class="text-slate-400 text-[11px]">Core Web Vitals</p>
                  <p class="text-emerald-400 font-semibold mt-0.5">99 / 100 Score</p>
                </div>
                <div class="bg-slate-800/60 p-3 rounded-lg">
                  <p class="text-slate-400 text-[11px]">Framework</p>
                  <p class="text-white font-semibold mt-0.5">Astro + Kotlin</p>
                </div>
              </div>

            </div>
          </div>

        </div>
      </section>

      <!-- Services Grid (Linked to /services) -->
      <section class="bg-slate-50 border-y border-slate-200 py-20">
        <div class="max-w-6xl mx-auto px-6">
          
          <div class="max-w-2xl mb-12">
            <h2 class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-2">Our Services</h2>
            <p class="text-3xl font-extrabold text-slate-900 tracking-tight">Software engineered for reliability</p>
            <p class="text-slate-600 mt-3 text-base">We focus on building tools that do one thing exceptionally well without bloated extras.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <!-- Service 1 -->
            <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
              <div>
                <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg mb-6">
                  📱
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Android App Development</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                  Modern native Android applications built with Kotlin and Jetpack Compose. Designed for low memory usage, offline-first reliability, and clean Play Store distribution.
                </p>
              </div>
              <a href="/services" class="text-sm font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1">
                Explore Android details &rarr;
              </a>
            </div>

            <!-- Service 2 -->
            <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
              <div>
                <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg mb-6">
                  ⚡
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Fast Web Engineering</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                  High-speed websites and web portals built on Astro. Fully indexable by Googlebot with zero JavaScript bloat, clean URLs, and global CDN delivery.
                </p>
              </div>
              <a href="/services" class="text-sm font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1">
                Explore Web services &rarr;
              </a>
            </div>

            <!-- Service 3 -->
            <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
              <div>
                <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-lg mb-6">
                  🧮
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Calculators & Web Tools</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                  Instant client-side calculation engines, salary calculators, and document utilities engineered for high user retention and strong organic search rankings.
                </p>
              </div>
              <a href="/services" class="text-sm font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1">
                Explore Tool development &rarr;
              </a>
            </div>

          </div>

        </div>
      </section>

      <!-- Tech Stack -->
      <section class="py-16 max-w-6xl mx-auto px-6 text-center">
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6">Built With Production-Grade Technologies</h3>
        <div class="flex flex-wrap items-center justify-center gap-3 max-w-3xl mx-auto text-sm font-medium text-slate-700">
          <span class="px-4 py-2 rounded-lg bg-slate-100 border border-slate-200">Kotlin</span>
          <span class="px-4 py-2 rounded-lg bg-slate-100 border border-slate-200">Jetpack Compose</span>
          <span class="px-4 py-2 rounded-lg bg-slate-100 border border-slate-200">Android SDK</span>
          <span class="px-4 py-2 rounded-lg bg-slate-100 border border-slate-200">Astro</span>
          <span class="px-4 py-2 rounded-lg bg-slate-100 border border-slate-200">Tailwind CSS</span>
          <span class="px-4 py-2 rounded-lg bg-slate-100 border border-slate-200">Cloudflare Pages</span>
          <span class="px-4 py-2 rounded-lg bg-slate-100 border border-slate-200">Google Search Console</span>
        </div>
      </section>

      <!-- Simple Banner CTA -->
      <section class="max-w-6xl mx-auto px-6 pb-20">
        <div class="bg-slate-900 text-white rounded-2xl p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-sm">
          <div class="max-w-xl text-center md:text-left">
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Have a project in mind?</h2>
            <p class="text-slate-400 text-sm mt-2">
              Whether you need an Android utility app or a fast web platform, we can build and launch it efficiently.
            </p>
          </div>
          <div class="flex items-center gap-3">
            <a 
              href="/start-project" 
              class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm transition-colors"
            >
              Start Project
            </a>
            <a 
              href="/contact" 
              class="px-5 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-medium text-sm transition-colors"
            >
              Contact Us
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Clean, Complete Footer -->
    <footer class="bg-slate-50 border-t border-slate-200 py-12 text-sm text-slate-600">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-slate-200">
          
          <!-- Column 1: Info -->
          <div>
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-3">
              <span class="w-6 h-6 rounded bg-blue-600 text-white flex items-center justify-center text-xs">L</span>
              LIDKA GLOBAL
            </div>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Independent digital venture building modern Android applications and clean web portals.
            </p>
            <p class="text-xs text-slate-500 font-mono">
              Domain: <span class="text-slate-800">lidkaglobal.com</span>
            </p>
          </div>

          <!-- Column 2: Navigation -->
          <div>
            <p class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">Pages</p>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-blue-600">Home</a></li>
              <li><a href="/services" class="hover:text-blue-600">Services</a></li>
              <li><a href="/portfolio" class="hover:text-blue-600">Portfolio</a></li>
              <li><a href="/about" class="hover:text-blue-600">About Us</a></li>
              <li><a href="/contact" class="hover:text-blue-600">Contact</a></li>
              <li><a href="/start-project" class="hover:text-blue-600">Start Project</a></li>
            </ul>
          </div>

          <!-- Column 3: Crawlability / Legal -->
          <div>
            <p class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">Legal & Sitemap</p>
            <ul class="space-y-2 text-xs">
              <li><a href="/privacy" class="hover:text-blue-600">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-blue-600">Terms of Service</a></li>
              <li><a href="/sitemap-index.xml" class="hover:text-blue-600 font-mono">sitemap-index.xml</a></li>
              <li><a href="/robots.txt" class="hover:text-blue-600 font-mono">robots.txt</a></li>
            </ul>
          </div>

          <!-- Column 4: Contact -->
          <div>
            <p class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">Contact</p>
            <p class="text-xs text-slate-500 mb-2">Direct email inquiries:</p>
            <a href={`mailto:${contactEmail}`} class="text-xs font-medium text-blue-600 hover:underline">
              {contactEmail}
            </a>
            <p class="text-[11px] text-slate-400 mt-3">
              Responses delivered within 24 business hours.
            </p>
          </div>

        </div>

        <!-- Copyright -->
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>&copy; {currentYear} LIDKA GLOBAL. All rights reserved.</p>
          <div class="flex items-center gap-4">
            <a href="/privacy" class="hover:underline">Privacy</a>
            <a href="/terms" class="hover:underline">Terms</a>
            <a href="/contact" class="hover:underline">Support</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Minimal script for mobile drawer -->
    <script is:inline>
      const btn = document.getElementById('mobileMenuBtn');
      const menu = document.getElementById('mobileMenu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
