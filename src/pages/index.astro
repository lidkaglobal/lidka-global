---
// src/pages/index.astro
// LIDKA GLOBAL - Official Homepage
const companyName = "LIDKA GLOBAL";
const siteUrl = "https://lidkaglobal.com";
const contactEmail = "lidkaglobal@gmail.com";
const pageTitle = "LIDKA GLOBAL | Android App & High-Performance Web Development";
const pageDescription = "LIDKA GLOBAL engineers native Android applications (Kotlin), high-speed Astro web platforms, and custom calculation utilities for modern enterprises.";
const currentYear = new Date().getFullYear();

// Structured Data (JSON-LD) for Google Search Console & Indexation
const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": companyName,
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.svg`,
      "email": contactEmail,
      "description": pageDescription,
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": contactEmail,
          "contactType": "customer service"
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": companyName,
      "description": pageDescription,
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO Metadata -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content={companyName} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={companyName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Typography & Performance Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <style>
      :root {
        --bg-main: #060913;
        --card-bg: rgba(15, 23, 42, 0.7);
        --card-border: rgba(255, 255, 255, 0.08);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-main);
        color: #f1f5f9;
        overflow-x: hidden;
        line-height: 1.6;
      }

      .code-font {
        font-family: 'JetBrains Mono', monospace;
      }

      .glass-panel {
        background: var(--card-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--card-border);
      }

      .glass-panel:hover {
        border-color: rgba(56, 189, 248, 0.35);
      }

      .brand-gradient {
        background: linear-gradient(135deg, #38bdf8 0%, #6366f1 50%, #d946ef 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .glow-orb-1 {
        position: absolute;
        top: -120px;
        left: 50%;
        transform: translateX(-50%);
        width: 750px;
        height: 750px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, rgba(99, 102, 241, 0.05) 50%, transparent 70%);
        filter: blur(85px);
        z-index: 0;
        pointer-events: none;
      }

      .glow-orb-2 {
        position: absolute;
        top: 55%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, rgba(16, 185, 129, 0.04) 50%, transparent 70%);
        filter: blur(90px);
        z-index: 0;
        pointer-events: none;
      }

      .tech-pill {
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.03);
        transition: all 0.3s ease;
      }
      .tech-pill:hover {
        border-color: #38bdf8;
        transform: translateY(-2px);
      }

      @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
      }
      .animate-float {
        animation: float 6s ease-in-out infinite;
      }
    </style>
  </head>

  <body class="relative min-h-screen">
    <!-- Ambient Background Elements -->
    <div class="glow-orb-1" aria-hidden="true"></div>
    <div class="glow-orb-2" aria-hidden="true"></div>

    <!-- Crawlable Navigation Header -->
    <header class="sticky top-0 z-50 glass-panel border-b border-white/10 px-6 lg:px-12 py-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group" title="LIDKA GLOBAL Homepage">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center font-bold text-white shadow-lg shadow-sky-500/20 group-hover:scale-105 transition-transform">
            L
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-xl tracking-tight text-white flex items-center gap-1">
              LIDKA<span class="brand-gradient font-black">GLOBAL</span>
            </span>
            <span class="text-[10px] tracking-widest text-slate-400 font-semibold uppercase -mt-1">Apps & Web Engineering</span>
          </div>
        </a>

        <!-- Desktop Crawlable Navigation (Individual Pages) -->
        <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-8 font-medium text-sm text-slate-300">
          <a href="/" class="text-sky-400 font-semibold transition-colors">Home</a>
          <a href="/about" class="hover:text-sky-400 transition-colors">About</a>
          <a href="/services" class="hover:text-sky-400 transition-colors">Services</a>
          <a href="/portfolio" class="hover:text-sky-400 transition-colors">Portfolio</a>
          <a href="/contact" class="hover:text-sky-400 transition-colors">Contact</a>
        </nav>

        <!-- CTA to Individual Start Project Page -->
        <div class="hidden md:flex items-center gap-4">
          <a 
            href="/start-project" 
            class="px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 text-white shadow-lg shadow-indigo-600/30 transition-all hover:scale-105"
          >
            Start Project &rarr;
          </a>
        </div>

        <!-- Mobile Toggle Button -->
        <button id="mobileMenuBtn" aria-label="Toggle Navigation Menu" class="md:hidden text-slate-300 hover:text-white p-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <nav id="mobileMenu" aria-label="Mobile Navigation" class="hidden md:hidden pt-4 pb-6 flex flex-col gap-4 border-t border-white/5 mt-3">
        <a href="/" class="text-sky-400 font-semibold">Home</a>
        <a href="/about" class="text-slate-300 hover:text-sky-400 font-medium">About</a>
        <a href="/services" class="text-slate-300 hover:text-sky-400 font-medium">Services</a>
        <a href="/portfolio" class="text-slate-300 hover:text-sky-400 font-medium">Portfolio</a>
        <a href="/contact" class="text-slate-300 hover:text-sky-400 font-medium">Contact</a>
        <a href="/start-project" class="w-full text-center py-3 rounded-xl font-bold bg-sky-500 text-white">Start Project</a>
      </nav>
    </header>

    <main id="main-content">
      <!-- Hero Section -->
      <section class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 pt-16 pb-24 md:pt-28 md:pb-36 flex flex-col lg:flex-row items-center justify-between gap-16">
        <article class="w-full lg:w-7/12 flex flex-col gap-6 text-center lg:text-left">
