              <li class="flex items-center gap-2"><span class="text-emerald-400">•</span> Mobile-Responsive Touch UIs</li>
            </ul>
          </article>
        </div>
      </section>

      <!-- Solutions & Architecture -->
      <section id="solutions" class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 py-20 border-t border-white/5">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs uppercase tracking-widest text-sky-400 font-bold">Proven Development Flow</span>
          <h2 class="text-3xl font-extrabold text-white mt-2">How We Deliver Software</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl glass-panel">
            <div class="text-3xl font-black text-sky-500/40 mb-3 font-mono">01</div>
            <h4 class="text-base font-bold text-white mb-2">Technical Scoping</h4>
