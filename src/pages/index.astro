    <!-- Minimal Client-side Script (Does not block Googlebot indexing) -->
    <script is:inline>
      const menuBtn = document.getElementById('mobileMenuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }

      const form = document.getElementById('contactForm');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const name = document.getElementById('senderName').value;
          const email = document.getElementById('senderEmail').value;
          const type = document.getElementById('projectType').value;
          const msg = document.getElementById('messageContent').value;

          const subject = encodeURIComponent(`LIDKA GLOBAL Inquiry: ${name} - ${type}`);
          const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nProject Type: ${type}\n\nProject Brief:\n${msg}`);

          window.location.href = `mailto:lidkaglobal@gmail.com?subject=${subject}&body=${body}`;
        });
      }
    </script>
