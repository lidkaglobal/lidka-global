      <!-- Mobile Dropdown Navigation -->
      <nav id="mobileMenu" aria-label="Mobile Navigation" class="hidden md:hidden pt-4 pb-6 flex flex-col gap-4 border-t border-white/5 mt-3">
        <a href="#home" class="text-slate-300 hover:text-sky-400 font-medium">Home</a>
