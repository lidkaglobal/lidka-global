            <div class="tech-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200">Kotlin</div>
            <div class="tech-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200">Jetpack Compose</div>
            <div class="tech-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200">Android SDK</div>
            <div class="tech-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200">Astro Framework</div>
            <div class="tech-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-200">Tailwind CSS</div>
