        <div>
          <h5 class="text-xs uppercase tracking-wider font-bold text-white mb-4">Pages</h5>
          <ul class="text-xs space-y-2.5 text-slate-400">
            <li><a href="/" class="hover:text-sky-400 transition-colors">Home</a></li>
            <li><a href="/about" class="hover:text-sky-400 transition-colors">About LIDKA GLOBAL</a></li>
