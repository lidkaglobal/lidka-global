---
// src/pages/index.astro
// LIDKA GLOBAL - Official Homepage
const companyName = "LIDKA GLOBAL";
const siteUrl = "https://lidkaglobal.com";
const pageUrl = siteUrl;
const contactEmail = "lidkaglobal@gmail.com";
const pageTitle = "LIDKA GLOBAL — Native Android Apps & High-Performance Web Engineering";
const pageDescription = "We engineer native Android applications and modern web platforms with clean code, responsive UI, and lightning speed. App development & web solutions.";
const currentYear = new Date().getFullYear();

// SEO Schema.org (JSON-LD) for Homepage
const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${pageUrl}/#website`,
      "url": pageUrl,
      "name": companyName,
      "description": pageDescription,
      "publisher": {
        "@type": "Organization",
        "@id": `${pageUrl}/#organization`,
        "name": companyName,
        "url": pageUrl,
        "email": contactEmail
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": pageUrl
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Essentials -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={companyName} />

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
      :root {
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --primary-light: #eff6ff;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --slate-50: #f8fafc;
        --emerald: #10b981;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #ffffff;
        color: var(--slate-900);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Navigation */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--slate-200);
      }

      .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }

      .logo-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--slate-900);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.5px;
      }

      .logo-badge {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.92rem;
        font-weight: 500;
        transition: color 0.2s ease;
      }

      .nav-links a:hover {
        color: var(--primary);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
      }

      .btn-primary {
        background-color: var(--primary);
        color: white;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.2);
      }

      .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-1px);
      }

      .btn-dark {
        background-color: var(--slate-900);
        color: white;
      }

      .btn-dark:hover {
        background-color: var(--slate-800);
      }

      /* Hero Section */
      .hero-section {
        padding: 100px 0 80px;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        border-bottom: 1px solid var(--slate-200);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
      }

      .hero-content h1 {
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: -1.2px;
        color: var(--slate-900);
        margin-bottom: 20px;
        line-height: 1.15;
      }

      .hero-desc {
        font-size: 1.1rem;
        color: var(--slate-600);
        margin-bottom: 32px;
        line-height: 1.7;
      }

      .hero-ctas {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
      }

      .hero-visual {
        background: var(--slate-900);
        border-radius: 20px;
        padding: 40px 32px;
        border: 1px solid var(--slate-800);
        box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.25);
        color: white;
      }

      .hero-visual h3 {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: #60a5fa;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
      }

      .hero-feature {
        display: flex;
        gap: 12px;
        margin-bottom: 16px;
        font-size: 0.95rem;
        align-items: flex-start;
      }

      .hero-feature strong {
        color: #e0e7ff;
        flex-shrink: 0;
      }

      .hero-feature span {
        color: #cbd5e1;
      }

      /* Features Grid */
      .features-section {
        padding: 80px 0;
      }

      .section-heading {
        text-align: center;
        margin-bottom: 60px;
      }

      .section-tag {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
      }

      .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.8px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .section-desc {
        font-size: 1.05rem;
        color: var(--slate-600);
        max-width: 550px;
        margin: 0 auto;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
      }

      .feature-card {
        background: white;
        padding: 32px 28px;
        border-radius: 16px;
        border: 1px solid var(--slate-200);
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .feature-card:hover {
        transform: translateY(-4px);
        border-color: #bfdbfe;
        box-shadow: 0 20px 35px -10px rgba(37, 99, 235, 0.1);
      }

      .feature-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 16px;
      }

      .feature-card h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--slate-900);
        margin-bottom: 10px;
      }

      .feature-card p {
        font-size: 0.92rem;
        color: var(--slate-600);
        line-height: 1.6;
      }

      /* Process Section */
      .process-section {
        padding: 80px 0;
        background-color: var(--slate-50);
        border-top: 1px solid var(--slate-200);
        border-bottom: 1px solid var(--slate-200);
      }

      .process-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
      }

      .process-card {
        background: white;
        padding: 28px 20px;
        border-radius: 14px;
        border: 1px solid var(--slate-200);
        text-align: center;
      }

      .process-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--primary);
        margin-bottom: 12px;
      }

      .process-card h4 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--slate-900);
        margin-bottom: 8px;
      }

      .process-card p {
        font-size: 0.85rem;
        color: var(--slate-600);
        line-height: 1.5;
      }

      /* CTA Banner */
      .cta-section {
        padding: 0 0 80px;
      }

      .cta-box {
        background: linear-gradient(135deg, var(--slate-900), #1e293b);
        border-radius: 24px;
        padding: 56px 48px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .cta-box h3 {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
      }

      .cta-box p {
        color: #94a3b8;
        font-size: 1rem;
        max-width: 520px;
      }

      /* Footer */
      footer {
        background: var(--slate-50);
        border-top: 1px solid var(--slate-200);
        padding: 64px 0 32px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 40px;
        margin-bottom: 48px;
      }

      .footer-col h5 {
        font-size: 0.82rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .footer-col ul {
        list-style: none;
      }

      .footer-col ul li {
        margin-bottom: 10px;
      }

      .footer-col ul li a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.88rem;
        transition: color 0.2s ease;
      }

      .footer-col ul li a:hover {
        color: var(--primary);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--slate-200);
        font-size: 0.82rem;
        color: var(--slate-500);
      }

      .mobile-toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      }

      .mobile-menu {
        display: none;
        flex-direction: column;
        gap: 12px;
        padding: 16px 24px;
        background: white;
        border-bottom: 1px solid var(--slate-200);
      }

      .mobile-menu a {
        text-decoration: none;
        color: var(--slate-700);
        font-weight: 600;
        padding: 6px 0;
      }

      /* Responsive Media Queries */
      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 32px;
        }

        .hero-content h1 {
          font-size: 2.5rem;
        }

        .features-grid {
          grid-template-columns: 1fr;
        }

        .process-grid {
          grid-template-columns: 1fr 1fr;
        }

        .cta-box {
          flex-direction: column;
          text-align: center;
          gap: 28px;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .nav-links, .header-cta {
          display: none;
        }

        .mobile-toggle {
          display: block;
        }
      }

      @media (max-width: 600px) {
        .process-grid {
          grid-template-columns: 1fr;
        }

        .hero-ctas {
          flex-direction: column;
        }

        .hero-ctas .btn {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <!-- Navigation Header -->
    <header>
      <div class="container nav-bar">
        <a href="/" class="logo-link">
          <div class="logo-badge">L</div>
          <span>LIDKA GLOBAL</span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/services">Services</a>
          <a href="/portfolio">Portfolio</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>

        <div class="header-cta">
          <a href="/start-project" class="btn btn-dark">Start Project &rarr;</a>
        </div>

        <button id="mobileBtn" class="mobile-toggle" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

      <nav id="mobileMenu" class="mobile-menu" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/portfolio">Portfolio</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/start-project" style="color: var(--primary);">Start Project &rarr;</a>
      </nav>
    </header>

    <main>
      <!-- Hero Section -->
      <section class="hero-section">
        <div class="container">
          <div class="hero-grid">
            <div class="hero-content">
              <h1>We engineer native apps and web systems that scale.</h1>
              <p class="hero-desc">
                LIDKA GLOBAL builds high-performance Android applications and modern web platforms with clean code, responsive UI, and lightning-fast performance.
              </p>
              <div class="hero-ctas">
                <a href="/start-project" class="btn btn-primary">Start a Project</a>
                <a href="/services" class="btn" style="background: var(--slate-100); color: var(--slate-900);">View Services</a>
              </div>
            </div>

            <div class="hero-visual">
              <h3>What We Build</h3>
              <div class="hero-feature">
                <strong>📱</strong>
                <span>Native Android apps with Kotlin & Jetpack Compose</span>
              </div>
              <div class="hero-feature">
                <strong>🌐</strong>
                <span>Fast web portals using Astro & Cloudflare Pages</span>
              </div>
              <div class="hero-feature">
                <strong>⚙️</strong>
                <span>Clean product engineering and system architecture</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="features-section">
        <div class="container">
          <div class="section-heading">
            <span class="section-tag">Core Capabilities</span>
            <h2 class="section-title">Solutions shaped for growth.</h2>
            <p class="section-desc">
              We focus exclusively on native Android development and high-speed web engineering—two disciplines where we excel.
            </p>
          </div>

          <div class="features-grid">
            <div class="feature-card">
              <div class="feature-icon">📱</div>
              <h3>Android Apps</h3>
              <p>Production-grade native apps built with modern Kotlin, Jetpack Compose, and offline-first architecture.</p>
            </div>

            <div class="feature-card">
              <div class="feature-icon">🌐</div>
              <h3>Web Platforms</h3>
              <p>Sub-second web experiences optimized for Googlebot crawling and edge CDN distribution with perfect Lighthouse scores.</p>
            </div>

            <div class="feature-card">
              <div class="feature-icon">⚙️</div>
              <h3>Product Engineering</h3>
              <p>Scalable system design, clean code architecture, and digital platforms that evolve with your business.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Process Section -->
      <section class="process-section">
        <div class="container">
          <div style="text-align: center; margin-bottom: 56px;">
            <span class="section-tag">How We Work</span>
            <h2 class="section-title">Our Delivery Method</h2>
          </div>

          <div class="process-grid">
            <div class="process-card">
              <div class="process-num">01</div>
              <h4>Architecture</h4>
              <p>We map data flow and screen hierarchies before writing code.</p>
            </div>

            <div class="process-card">
              <div class="process-num">02</div>
              <h4>Sprint Build</h4>
              <p>Rapid iterative sprints with continuous preview milestones.</p>
            </div>

            <div class="process-card">
              <div class="process-num">03</div>
              <h4>Performance Audit</h4>
              <p>Strict testing and optimization for speed and reliability.</p>
            </div>

            <div class="process-card">
              <div class="process-num">04</div>
              <h4>Live Deployment</h4>
              <p>Direct deployment to Google Play or edge network.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section">
        <div class="container">
          <div class="cta-box">
            <div>
              <h3>Ready to build something great?</h3>
              <p>Let's turn your next idea into a product people trust and remember.</p>
            </div>
            <div style="display: flex; gap: 12px;">
              <a href="/start-project" class="btn btn-primary">Start a Project</a>
              <a href="/contact" class="btn" style="background: rgba(255,255,255,0.1); color: white;">Contact Us</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer>
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="logo-link" style="margin-bottom: 12px;">
              <div class="logo-badge" style="width: 30px; height: 30px; font-size: 0.9rem;">L</div>
              <span style="font-size: 1.1rem;">LIDKA GLOBAL</span>
            </div>
            <p style="font-size: 0.85rem; color: var(--slate-500); line-height: 1.6; margin-bottom: 8px;">
              Independent software and app engineering firm creating lightweight, scalable tools.
            </p>
            <p style="font-size: 0.8rem; color: var(--slate-700); font-family: 'JetBrains Mono', monospace;">
              lidkaglobal.com
            </p>
          </div>

          <div class="footer-col">
            <h5>Navigation</h5>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/portfolio">Portfolio</a></li>
              <li><a href="/about">About Us</a></li>
              <li><a href="/start-project">Start Project</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h5>SEO & Legal</h5>
            <ul>
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms">Terms of Service</a></li>
              <li><a href="/robots.txt">robots.txt</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h5>Direct Contact</h5>
            <ul>
              <li>
                <a href={`mailto:${contactEmail}`} style="font-weight: 600; color: var(--primary);">
                  {contactEmail}
                </a>
              </li>
              <li style="font-size: 0.8rem; color: var(--slate-500); margin-top: 8px;">
                Responses provided within 24 business hours.
              </li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <div>&copy; {currentYear} LIDKA GLOBAL. All rights reserved.</div>
          <div>
            <a href="/privacy" style="text-decoration: none; color: var(--slate-500); margin-right: 16px;">Privacy</a>
            <a href="/terms" style="text-decoration: none; color: var(--slate-500);">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script is:inline>
      const btn = document.getElementById('mobileBtn');
      const menu = document.getElementById('mobileMenu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
        });
      }
    </script>
  </body>
</html>
