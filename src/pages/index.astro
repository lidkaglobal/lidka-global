            </a>
          </article>

          <!-- Card 3 -->
          <article class="glass-panel p-8 rounded-2xl flex flex-col justify-between transition-all hover:-translate-y-1">
            <div>
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-400/30 flex items-center justify-center text-emerald-400 text-xl font-bold mb-6">
