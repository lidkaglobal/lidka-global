    </main>

    <!-- Crawlable Footer with Individual Links -->
    <footer class="relative z-10 glass-panel border-t border-white/10 py-16 px-6 lg:px-12 mt-20">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/5">
