---
// src/pages/index.astro
// LIDKA GLOBAL - Official Modern Astro Homepage
const companyName = "LIDKA GLOBAL";
const siteUrl = "https://lidkaglobal.com";
const contactEmail = "lidkaglobal@gmail.com";
const pageTitle = "LIDKA GLOBAL — Modern Android Apps & Web Engineering";
const pageDescription = "LIDKA GLOBAL builds high-performance Android applications and modern web platforms with clean code, responsive UI, and lightning speed.";
const currentYear = new Date().getFullYear();

// SEO Schema.org (JSON-LD) for Google Search Console
const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": companyName,
      "url": siteUrl,
      "logo": `${siteUrl}/favicon.svg`,
      "email": contactEmail,
      "description": pageDescription,
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "email": contactEmail,
          "contactType": "customer service"
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": companyName,
      "description": pageDescription,
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Essentials -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={companyName} />

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
      :root {
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --primary-light: #eff6ff;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --slate-50: #f8fafc;
        --emerald: #10b981;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #ffffff;
        color: var(--slate-900);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Navigation */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--slate-200);
      }

      .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }

      .logo-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--slate-900);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.5px;
      }

      .logo-badge {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.92rem;
        font-weight: 500;
        transition: color 0.2s ease;
      }

      .nav-links a:hover, .nav-links a.active {
        color: var(--primary);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
      }

      .btn-primary {
        background-color: var(--primary);
        color: white;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.2);
      }

      .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-1px);
      }

      .btn-secondary {
        background-color: white;
        color: var(--slate-700);
        border: 1px solid var(--slate-200);
      }

      .btn-secondary:hover {
        background-color: var(--slate-50);
        border-color: var(--slate-300);
      }

      .btn-dark {
        background-color: var(--slate-900);
        color: white;
      }

      .btn-dark:hover {
        background-color: var(--slate-800);
      }

      /* Hero Section */
      .hero-section {
        padding: 70px 0 100px;
        position: relative;
        overflow: hidden;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 48px;
        align-items: center;
      }

      .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 9999px;
        background-color: var(--primary-light);
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 20px;
        border: 1px solid rgba(37, 99, 235, 0.15);
      }

      .badge-dot {
        width: 8px;
        height: 8px;
        background-color: var(--primary);
        border-radius: 50%;
      }

      .hero-title {
        font-size: 3.2rem;
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1.5px;
        color: var(--slate-900);
        margin-bottom: 20px;
      }

      .hero-desc {
        font-size: 1.15rem;
        line-height: 1.65;
        color: var(--slate-600);
        margin-bottom: 32px;
      }

      .hero-actions {
        display: flex;
        gap: 14px;
        margin-bottom: 40px;
      }

      .trust-row {
        display: flex;
        gap: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--slate-200);
      }

      .trust-item h4 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--slate-900);
      }

      .trust-item p {
        font-size: 0.8rem;
        color: var(--slate-500);
      }

      /* Graphical Mockups */
      .graphics-wrapper {
        position: relative;
        display: flex;
        justify-content: center;
      }

      .device-container {
        position: relative;
        width: 320px;
        background: #090d16;
        border-radius: 44px;
        padding: 14px;
        border: 4px solid #1e293b;
        box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.35);
      }

      .phone-notch {
        width: 110px;
        height: 18px;
        background: #090d16;
        border-radius: 20px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }

      .camera-dot {
        width: 7px;
        height: 7px;
        background: #1e293b;
        border-radius: 50%;
      }

      .speaker-line {
        width: 36px;
        height: 4px;
        background: #1e293b;
        border-radius: 4px;
      }

      .app-screen {
        background: #0f172a;
        border-radius: 32px;
        padding: 20px 16px;
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .screen-badge {
        font-size: 0.72rem;
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 600;
      }

      .mockup-card {
        background: rgba(30, 41, 59, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 14px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .mockup-card-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .code-snippet-box {
        background: #030712;
        border-radius: 12px;
        padding: 12px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #93c5fd;
        border: 1px solid rgba(255, 255, 255, 0.05);
        margin-top: 14px;
        line-height: 1.4;
      }

      .floating-badge {
        position: absolute;
        bottom: -20px;
        left: -20px;
        background: white;
        padding: 12px 18px;
        border-radius: 16px;
        border: 1px solid var(--slate-200);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        gap: 12px;
      }

      /* Services Section (2 Columns) */
      .services-section {
        background-color: var(--slate-50);
        padding: 90px 0;
        border-top: 1px solid var(--slate-200);
        border-bottom: 1px solid var(--slate-200);
      }

      .section-header {
        max-width: 600px;
        margin-bottom: 48px;
      }

      .section-tag {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
      }

      .section-title {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.8px;
        color: var(--slate-900);
      }

      .cards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
      }

      .service-card {
        background: white;
        padding: 36px 32px;
        border-radius: 16px;
        border: 1px solid var(--slate-200);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .service-card:hover {
        transform: translateY(-4px);
        border-color: #bfdbfe;
        box-shadow: 0 12px 30px rgba(37, 99, 235, 0.08);
      }

      .service-icon-box {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 24px;
      }

      .service-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--slate-900);
        margin-bottom: 12px;
      }

      .service-desc {
        font-size: 0.95rem;
        color: var(--slate-600);
        line-height: 1.65;
        margin-bottom: 24px;
      }

      .card-link {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--primary);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .card-link:hover {
        text-decoration: underline;
      }

      /* Stack section */
      .stack-section {
        padding: 70px 0;
        text-align: center;
      }

      .pills-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 24px;
      }

      .tech-badge {
        padding: 8px 16px;
        border-radius: 8px;
        background: var(--slate-100);
        border: 1px solid var(--slate-200);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--slate-700);
      }

      /* Banner CTA */
      .cta-section {
        padding: 0 0 90px;
      }

      .cta-box {
        background: linear-gradient(135deg, var(--slate-900), #1e293b);
        border-radius: 24px;
        padding: 56px 48px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .cta-box h3 {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
      }

      .cta-box p {
        color: #94a3b8;
        font-size: 1rem;
        max-width: 520px;
      }

      /* Footer */
      footer {
        background: var(--slate-50);
        border-top: 1px solid var(--slate-200);
        padding: 64px 0 32px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 40px;
        margin-bottom: 48px;
      }

      .footer-col h5 {
        font-size: 0.82rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .footer-col ul {
        list-style: none;
      }

      .footer-col ul li {
        margin-bottom: 10px;
      }

      .footer-col ul li a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.88rem;
        transition: color 0.2s ease;
      }

      .footer-col ul li a:hover {
        color: var(--primary);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--slate-200);
        font-size: 0.82rem;
        color: var(--slate-500);
      }

      .mobile-toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      }

      .mobile-menu {
        display: none;
        flex-direction: column;
        gap: 12px;
        padding: 16px 24px;
        background: white;
        border-bottom: 1px solid var(--slate-200);
      }

      .mobile-menu a {
        text-decoration: none;
        color: var(--slate-700);
        font-weight: 600;
        padding: 6px 0;
      }

      /* Responsive Media Queries */
      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
          text-align: center;
        }

        .hero-actions {
          justify-content: center;
        }

        .trust-row {
          justify-content: center;
        }

        .cards-grid {
          grid-template-columns: 1fr;
        }

        .cta-box {
          flex-direction: column;
          text-align: center;
          gap: 28px;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .nav-links, .header-cta {
          display: none;
        }

        .mobile-toggle {
          display: block;
        }

        .hero-title {
          font-size: 2.4rem;
        }
      }
    </style>
  </head>

  <body>
    <!-- Crawlable Navigation Header -->
    <header>
      <div class="container nav-bar">
        <a href="/" class="logo-link">
          <div class="logo-badge">L</div>
          <span>LIDKA GLOBAL</span>
        </a>

        <!-- Individual Crawlable Links -->
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/" class="active">Home</a>
          <a href="/services">Services</a>
          <a href="/portfolio">Portfolio</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>

        <div class="header-cta">
          <a href="/start-project" class="btn btn-dark">Start Project &rarr;</a>
        </div>

        <button id="mobileBtn" class="mobile-toggle" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <nav id="mobileMenu" class="mobile-menu" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/portfolio">Portfolio</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/start-project" style="color: var(--primary);">Start Project &rarr;</a>
      </nav>
    </header>

    <main>
      <!-- Hero Section with Vector Graphics -->
      <section class="hero-section">
        <div class="container hero-grid">
          <div>
            <div class="badge-pill">
              <span class="badge-dot"></span>
              Android App & Web Development Firm
            </div>

            <h1 class="hero-title">
              We engineer native apps and web systems that scale.
            </h1>

            <p class="hero-desc">
              LIDKA GLOBAL designs native Android applications and modern static web platforms. Clean code architecture, zero bloat, and engineered for sub-second speeds.
            </p>

            <div class="hero-actions">
              <a href="/start-project" class="btn btn-primary">Start a Project</a>
              <a href="/services" class="btn btn-secondary">Explore Services</a>
            </div>

            <div class="trust-row">
              <div class="trust-item">
                <h4>Native Android</h4>
                <p>Kotlin & Compose</p>
              </div>
              <div class="trust-item">
                <h4>Blazing Fast</h4>
                <p>Astro + Edge CDN</p>
              </div>
              <div class="trust-item">
                <h4>Clean Indexing</h4>
                <p>100% Crawlable</p>
              </div>
            </div>
          </div>

          <!-- Smartphone / Code Graphics -->
          <div class="graphics-wrapper">
            <div class="device-container">
              <div class="phone-notch">
                <div class="camera-dot"></div>
                <div class="speaker-line"></div>
              </div>

              <div class="app-screen">
                <div class="app-header">
                  <span style="font-weight: 700; font-size: 0.85rem;">LIDKA Engine</span>
                  <span class="screen-badge">Active 60fps</span>
                </div>

                <!-- Graphic Card 1 -->
                <div class="mockup-card">
                  <div class="mockup-card-icon" style="background: rgba(37, 99, 235, 0.2);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2">
                      <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                      <path d="M12 18h.01"/>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size: 0.78rem; font-weight: 700;">Native Performance</div>
                    <div style="font-size: 0.68rem; color: #94a3b8;">Zero runtime stutter</div>
                  </div>
                </div>

                <!-- Graphic Card 2 -->
                <div class="mockup-card">
                  <div class="mockup-card-icon" style="background: rgba(16, 185, 129, 0.2);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                    </svg>
                  </div>
                  <div>
                    <div style="font-size: 0.78rem; font-weight: 700;">Instant Launch</div>
                    <div style="font-size: 0.68rem; color: #94a3b8;">Sub-100ms startup</div>
                  </div>
                </div>

                <!-- Code Graphic Preview -->
                <div class="code-snippet-box">
                  <span style="color: #c084fc;">class</span> <span style="color: #60a5fa;">LidkaEngine</span> &#123;<br/>
                  &nbsp;&nbsp;<span style="color: #c084fc;">val</span> status = <span style="color: #34d399;">"Ready"</span><br/>
                  &nbsp;&nbsp;<span style="color: #94a3b8;">// Sub-second load</span><br/>
                  &#125;
                </div>
              </div>
            </div>

            <!-- Floating Badge Graphic -->
            <div class="floating-badge">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
              </svg>
              <div>
                <div style="font-size: 0.75rem; font-weight: 700; color: #0f172a;">Google Index Ready</div>
                <div style="font-size: 0.65rem; color: #64748b;">Valid Schema & Tags</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Services Cards Section (Now Clean 2-Column Grid) -->
      <section class="services-section">
        <div class="container">
          <div class="section-header">
            <span class="section-tag">Capabilities</span>
            <h2 class="section-title">What We Build at LIDKA GLOBAL</h2>
          </div>

          <div class="cards-grid">
            <!-- Service 1: Android -->
            <div class="service-card">
              <div>
                <div class="service-icon-box" style="background: #eff6ff; color: #2563eb;">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                    <path d="M12 18h.01"/>
                  </svg>
                </div>
                <h3 class="service-title">Android App Development</h3>
                <p class="service-desc">
                  Native Android apps built using modern Kotlin and Jetpack Compose. Designed for low memory consumption, offline Room storage, clean Google Play Console deployment, and App Store Optimization.
                </p>
              </div>
              <a href="/services" class="card-link">View Android Services &rarr;</a>
            </div>

            <!-- Service 2: Web -->
            <div class="service-card">
              <div>
                <div class="service-icon-box" style="background: #f0fdf4; color: #16a34a;">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" x2="22" y1="12" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                </div>
                <h3 class="service-title">High-Speed Web Portals</h3>
                <p class="service-desc">
