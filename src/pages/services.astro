---
// src/pages/services.astro
// LIDKA GLOBAL - Official Services Page
const companyName = "LIDKA GLOBAL";
const siteUrl = "https://lidkaglobal.com";
const pageUrl = `${siteUrl}/services`;
const contactEmail = "lidkaglobal@gmail.com";
const pageTitle = "Engineering Services — LIDKA GLOBAL | Android & Web Solutions";
const pageDescription = "Explore LIDKA GLOBAL's core engineering services: Native Android application development with Kotlin and high-performance Astro web engineering.";
const currentYear = new Date().getFullYear();

// SEO Schema.org (JSON-LD) for Services Page & Google Search Console
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "name": companyName,
        "url": siteUrl
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": siteUrl
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Services",
            "item": pageUrl
          }
        ]
      }
    },
    {
      "@type": "Service",
      "name": "Native Android App Development",
      "provider": {
        "@type": "Organization",
        "name": companyName,
        "url": siteUrl
      },
      "description": "Production-grade native Android applications built with Kotlin, Jetpack Compose, Room DB, and AdMob integration."
    },
    {
      "@type": "Service",
      "name": "High-Speed Web Engineering",
      "provider": {
        "@type": "Organization",
        "name": companyName,
        "url": siteUrl
      },
      "description": "Sub-second static and server-rendered web platforms built on Astro, optimized for Googlebot crawling and edge CDN distribution."
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Essentials -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={companyName} />

    <!-- Schema Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
      :root {
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --primary-light: #eff6ff;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --slate-50: #f8fafc;
        --emerald: #10b981;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #ffffff;
        color: var(--slate-900);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Navigation */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--slate-200);
      }

      .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
      }

      .logo-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--slate-900);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.5px;
      }

      .logo-badge {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-links a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.92rem;
        font-weight: 500;
        transition: color 0.2s ease;
      }

      .nav-links a:hover, .nav-links a.active {
        color: var(--primary);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        border: none;
      }

      .btn-primary {
        background-color: var(--primary);
        color: white;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.2);
      }

      .btn-primary:hover {
        background-color: var(--primary-hover);
        transform: translateY(-1px);
      }

      .btn-dark {
        background-color: var(--slate-900);
        color: white;
      }

      .btn-dark:hover {
        background-color: var(--slate-800);
      }

      /* Hero Section */
      .page-hero {
        padding: 60px 0 50px;
        text-align: center;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        border-bottom: 1px solid var(--slate-200);
      }

      .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 9999px;
        background-color: var(--primary-light);
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 16px;
        border: 1px solid rgba(37, 99, 235, 0.15);
      }

      .page-title {
        font-size: 2.8rem;
        font-weight: 800;
        letter-spacing: -1.2px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .page-desc {
        font-size: 1.15rem;
        color: var(--slate-600);
        max-width: 680px;
        margin: 0 auto;
        line-height: 1.6;
      }

      /* Main Service Deep Dive Blocks */
      .service-block {
        padding: 80px 0;
        border-bottom: 1px solid var(--slate-200);
      }

      .service-block:nth-child(even) {
        background-color: var(--slate-50);
      }

      .service-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
      }

      .service-grid.reversed {
        direction: rtl;
      }

      .service-grid.reversed > * {
        direction: ltr;
      }

      .service-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
      }

      .service-heading {
        font-size: 2.1rem;
        font-weight: 800;
        letter-spacing: -0.6px;
        color: var(--slate-900);
        margin-bottom: 16px;
        line-height: 1.25;
      }

      .service-text {
        font-size: 1rem;
        color: var(--slate-600);
        line-height: 1.7;
        margin-bottom: 24px;
      }

      .feature-list {
        list-style: none;
        margin-bottom: 32px;
      }

      .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
        font-size: 0.95rem;
        color: var(--slate-700);
      }

      .check-icon {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: var(--primary-light);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 800;
        flex-shrink: 0;
        margin-top: 2px;
      }

      /* Graphic Visuals */
      .visual-box {
        background: #0f172a;
        border-radius: 20px;
        padding: 32px;
        border: 1px solid var(--slate-800);
        box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.25);
        color: white;
      }

      .visual-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 16px;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .dots {
        display: flex;
        gap: 6px;
      }

      .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
      }

      .code-snippet {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        line-height: 1.6;
        color: #94a3b8;
      }

      .metric-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        font-weight: 600;
        font-size: 0.75rem;
      }

      /* Workflow Section */
      .workflow-section {
        padding: 80px 0;
        text-align: center;
      }

      .workflow-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 12px;
      }

      .workflow-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-top: 48px;
      }

      .workflow-card {
        padding: 28px 20px;
        border-radius: 14px;
        background: white;
        border: 1px solid var(--slate-200);
        text-align: left;
      }

      .workflow-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--primary);
        margin-bottom: 12px;
      }

      .workflow-heading {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--slate-900);
        margin-bottom: 8px;
      }

      .workflow-desc {
        font-size: 0.85rem;
        color: var(--slate-600);
        line-height: 1.5;
      }

      /* CTA Banner */
      .cta-section {
        padding: 0 0 90px;
      }

      .cta-box {
        background: linear-gradient(135deg, var(--slate-900), #1e293b);
        border-radius: 24px;
        padding: 56px 48px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .cta-box h3 {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
      }

      .cta-box p {
        color: #94a3b8;
        font-size: 1rem;
        max-width: 520px;
      }

      /* Footer */
      footer {
        background: var(--slate-50);
        border-top: 1px solid var(--slate-200);
        padding: 64px 0 32px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 40px;
        margin-bottom: 48px;
      }

      .footer-col h5 {
        font-size: 0.82rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--slate-900);
        margin-bottom: 16px;
      }

      .footer-col ul {
        list-style: none;
      }

      .footer-col ul li {
        margin-bottom: 10px;
      }

      .footer-col ul li a {
        text-decoration: none;
        color: var(--slate-600);
        font-size: 0.88rem;
        transition: color 0.2s ease;
      }

      .footer-col ul li a:hover {
        color: var(--primary);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        border-top: 1px solid var(--slate-200);
        font-size: 0.82rem;
        color: var(--slate-500);
      }

      .mobile-toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
      }

      .mobile-menu {
        display: none;
        flex-direction: column;
        gap: 12px;
        padding: 16px 24px;
        background: white;
        border-bottom: 1px solid var(--slate-200);
      }

      .mobile-menu a {
        text-decoration: none;
        color: var(--slate-700);
        font-weight: 600;
        padding: 6px 0;
      }

      /* Media Queries */
      @media (max-width: 900px) {
        .service-grid, .service-grid.reversed {
          grid-template-columns: 1fr;
          direction: ltr;
        }

        .workflow-grid {
          grid-template-columns: 1fr 1fr;
        }

        .cta-box {
          flex-direction: column;
          text-align: center;
          gap: 28px;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .nav-links, .header-cta {
          display: none;
        }

        .mobile-toggle {
          display: block;
        }

        .page-title {
          font-size: 2.2rem;
        }
      }

      @media (max-width: 600px) {
        .workflow-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <!-- Crawlable Navigation Header -->
    <header>
      <div class="container nav-bar">
        <a href="/" class="logo-link">
          <div class="logo-badge">L</div>
          <span>LIDKA GLOBAL</span>
        </a>

        <!-- Individual Crawlable Links -->
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/services" class="active">Services</a>
          <a href="/portfolio">Portfolio</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>

        <div class="header-cta">
          <a href="/start-project" class="btn btn-dark">Start Project &rarr;</a>
        </div>

        <button id="mobileBtn" class="mobile-toggle" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <nav id="mobileMenu" class="mobile-menu" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a href="/services" style="color: var(--primary);">Services</a>
        <a href="/portfolio">Portfolio</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/start-project" style="color: var(--primary);">Start Project &rarr;</a>
      </nav>
    </header>

    <main>
      <!-- Services Hero Header -->
      <section class="page-hero">
        <div class="container">
          <div class="badge-pill">
            <span>Specialized Capabilities</span>
          </div>
          <h1 class="page-title">Engineering Services</h1>
          <p class="page-desc">
            We focus exclusively on two high-impact disciplines: native Android mobile software and sub-second Astro web engineering. Zero bloat, production-ready.
          </p>
        </div>
      </section>

      <!-- Service 1: Android Application Engineering -->
      <section class="service-block">
        <div class="container service-grid">
          <div>
            <div class="service-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                <path d="M12 18h.01"/>
              </svg>
              Mobile Engineering
            </div>
            <h2 class="service-heading">Native Android Application Development</h2>
            <p class="service-text">
              We design and construct native Android applications using modern Kotlin and Jetpack Compose. By adhering strictly to Google’s recommended MVVM/MVI architecture, we guarantee fluid frame rates, offline-first reliability, and clean execution.
            </p>

            <ul class="feature-list">
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Kotlin & Jetpack Compose:</strong> Declarative, modern UI with minimal memory footprint.</span>
              </li>
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Offline-First Storage:</strong> Robust local caching and relational storage via Room Database.</span>
              </li>
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Monetization & Analytics:</strong> Clean Google AdMob integration without compromising UI responsiveness.</span>
              </li>
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Google Play Console Ready:</strong> Complete APK/AAB bundling, metadata optimization, and App Store Optimization (ASO).</span>
              </li>
            </ul>

            <a href="/start-project" class="btn btn-primary">Build an Android App &rarr;</a>
          </div>

          <!-- Code Visual for Android -->
          <div class="visual-box">
            <div class="visual-header">
              <div class="dots">
                <div class="dot" style="background: #ef4444;"></div>
                <div class="dot" style="background: #f59e0b;"></div>
                <div class="dot" style="background: #10b981;"></div>
              </div>
              <span class="metric-pill">Compose 120 FPS</span>
            </div>
            <div class="code-snippet">
              <span style="color: #c084fc;">@Composable</span><br/>
              <span style="color: #60a5fa;">fun</span> <span style="color: #fcd34d;">LidkaAppScreen</span>() &#123;<br/>
              &nbsp;&nbsp;<span style="color: #c084fc;">val</span> state <span style="color: #60a5fa;">by</span> viewModel.uiState.collectAsState()<br/>
              &nbsp;&nbsp;<span style="color: #fcd34d;">Scaffold</span>(<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;topBar = &#123; <span style="color: #fcd34d;">TopAppBar</span>(title = &#123; <span style="color: #34d399;">"Lidka App"</span> &#125;) &#125;<br/>
              &nbsp;&nbsp;) &#123; padding -&gt;<br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span style="color: #94a3b8;">// Reactive high-speed local render</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span style="color: #fcd34d;">AppContent</span>(state, modifier = Modifier.padding(padding))<br/>
              &nbsp;&nbsp;&#125;<br/>
              &#125;
            </div>
          </div>
        </div>
      </section>

      <!-- Service 2: Modern High-Speed Web Engineering -->
      <section class="service-block">
        <div class="container service-grid reversed">
          <div>
            <div class="service-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" x2="22" y1="12" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              Web Architecture
            </div>
            <h2 class="service-heading">High-Speed Astro Web Portals</h2>
            <p class="service-text">
              We engineer blazing-fast static and edge-rendered web platforms using Astro. Our sites strip away JavaScript overhead, delivering pure semantic HTML and CSS that search engine crawlers can read immediately with near-instant Time to First Byte (TTFB).
            </p>

            <ul class="feature-list">
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Zero-JS by Default:</strong> Eliminates runtime rendering lag for perfect 99-100 Google Lighthouse scores.</span>
              </li>
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Googlebot Optimized:</strong> Native XML sitemaps, structured JSON-LD schemas, and clean URL hierarchies.</span>
              </li>
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Edge CDN Distribution:</strong> Deployed on Cloudflare Pages global network with SSL and edge caching.</span>
              </li>
              <li class="feature-item">
                <span class="check-icon">&#10003;</span>
                <span><strong>Mobile-First Architecture:</strong> Fully responsive designs tested across dozens of device viewports.</span>
              </li>
            </ul>

            <a href="/start-project" class="btn btn-primary">Build a Fast Website &rarr;</a>
          </div>

          <!-- Code Visual for Web -->
          <div class="visual-box">
            <div class="visual-header">
              <div class="dots">
                <div class="dot" style="background: #ef4444;"></div>
                <div class="dot" style="background: #f59e0b;"></div>
                <div class="dot" style="background: #10b981;"></div>
              </div>
              <span class="metric-pill">Core Web Vitals 100/100</span>
            </div>
            <div class="code-snippet">
              <span style="color: #94a3b8;">---</span><br/>
              <span style="color: #c084fc;">// Pre-rendered at build time (Zero Server Delay)</span><br/>
              <span style="color: #60a5fa;">const</span> page = <span style="color: #60a5fa;">await</span> fetchAstroData();<br/>
              <span style="color: #94a3b8;">---</span><br/><br/>
              <span style="color: #60a5fa;">&lt;html&gt;</span><br/>
              &nbsp;&nbsp;<span style="color: #60a5fa;">&lt;body&gt;</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span style="color: #60a5fa;">&lt;h1&gt;</span>&#123;page.title&#125;<span style="color: #60a5fa;">&lt;/h1&gt;</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span style="color: #94a3b8;">&lt;!-- Shipped as pure HTML to Googlebot --&gt;</span><br/>
              &nbsp;&nbsp;&nbsp;&nbsp;<span style="color: #60a5fa;">&lt;article&gt;</span>&#123;page.content&#125;<span style="color: #60a5fa;">&lt;/article&gt;</span><br/>
              &nbsp;&nbsp;<span style="color: #60a5fa;">&lt;/body&gt;</span><br/>
              <span style="color: #60a5fa;">&lt;/html&gt;</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Structured Process / Workflow -->
      <section class="workflow-section">
        <div class="container">
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 1px;">Our Delivery Method</span>
          <h2 class="workflow-title">How We Ship Your Application</h2>

          <div class="workflow-grid">
            <div class="workflow-card">
              <div class="workflow-num">01</div>
              <h3 class="workflow-heading">Architecture</h3>
